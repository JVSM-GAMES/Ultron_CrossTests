# Gerando dados fictícios
x = np.linspace([0, 10, 1000])
y = np.sin(x)

# Criando o gráfico com comandos tradicionais do pyplot
plt.figure()
plt.plot(x, y, label="Sinal Senoidal", color="blue")
plt.title("Exemplo Prático com a Biblioteca XY")
plt.xlabel("Eixo X")
plt.ylabel("Eixo Y")
plt.legend()

# Exporta diretamente para um arquivo HTML interativo com WebGL2
