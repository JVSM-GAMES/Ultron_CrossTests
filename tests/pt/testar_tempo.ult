# Pega o tempo atual
agora = tempo()
afirmar(agora > 1787279831048)

# Dorme por 500ms
inicio = tempo()
dormir(500)
fim = tempo()

# Calculando a latência exata!
decorrido = fim - inicio

# Verifica se o atraso foi igual ou levemente superior a 500ms 
# (Sempre há margem de drift do Kernel do Sistema Operacional)
afirmar(decorrido >= 500 e decorrido <= 502)

inicio_curto = tempo()
atrasar(10)
atrasar(10)
atrasar(10)
fim_curto = tempo()

total_curto = fim_curto - inicio_curto
afirmar(total_curto >= 30 e total_curto <= 36)