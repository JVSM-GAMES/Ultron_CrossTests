afirmar(conta_composta != 0.0006097251155938)
afirmar(conta_composta == 0.0006097251155937198)
afirmar(conta_composta != 0.0006097251155937197)
afirmar(conta_composta != 0.0006097251155937199)
afirmar(0.1 + 0.2 = 0.3)
afirmar(0.1 + 0.2 == 0.30000000000000004)
afirmar(0.1 + 0.2 != 0.30000000000000001)