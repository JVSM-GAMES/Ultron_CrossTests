# ==========================================
# FASE 1: VERBOS HTTP E DUCK-TYPING JSON
# ==========================================

# GET (JSONPlaceholder - Extremamente Estável)
res_get = solicitar("https://jsonplaceholder.typicode.com/users/1").avancado({ "method": "GET" })
afirmar(res_get.status == 200)
afirmar(res_get.ok == verdadeiro)

# POST (Dicionário aninhado sendo enviado)
# JSONPlaceholder retorna 201 (Created) quando adicionamos algo
res_post = solicitar("https://jsonplaceholder.typicode.com/posts").avancado({ 
    "method": "POST", 
    "body": { "title": "Ultron C11" } 
})
afirmar(res_post.status == 201)
dados_post = res_post.texto.json()
afirmar(dados_post["title"] == "Ultron C11")

# PUT
res_put = solicitar("https://jsonplaceholder.typicode.com/posts/1").avancado({ "method": "PUT", "body": { "title": "Atualizado" } })
afirmar(res_put.status == 200)
afirmar(res_put.texto.json()["title"] == "Atualizado")

# PATCH
res_patch = solicitar("https://jsonplaceholder.typicode.com/posts/1").avancado({ "method": "PATCH", "body": { "title": "Ultron Patch" } })
afirmar(res_patch.status == 200)
afirmar(res_patch.texto.json()["title"] == "Ultron Patch")

# DELETE
res_del = solicitar("https://jsonplaceholder.typicode.com/posts/1").avancado({ "method": "DELETE" })
afirmar(res_del.status == 200)


# ==========================================
# FASE 2: RESILIÊNCIA, TIMEOUTS E REDIRECTS
# ==========================================

# DNS Inexistente (Failsafe Zero Crash)
res_dns = solicitar("https://dominio-inexistente-12345.com").avancado({"method": "GET"})
afirmar(res_dns.status == 0)
afirmar(res_dns.ok == falso)

# Timeout de Fibra (Failsafe sem travar CPU)
# ReqRes tem um simulador de delay perfeito. Pedimos 5s e o Ultron corta em 2s.
res_time = solicitar("https://reqres.in/api/users?delay=5").avancado({ "method": "GET", "timeout": 2 })
afirmar(res_time.status == 0)

# Redirecionamentos (3xx -> 200)
# Acessar google.com sem www redireciona para a versão final com www. O Motor segue ativamente!
res_redir = solicitar("https://google.com").avancado({"method": "GET"})
afirmar(res_redir.status == 200)
afirmar(res_redir.url == "https://www.google.com/")

# 404 Not Found (Captura limpa)
res_404 = solicitar("https://jsonplaceholder.typicode.com/url_invalida_404").avancado({ "method": "GET" })
afirmar(res_404.status == 404)
afirmar(res_404.ok == falso)


# ==========================================
# FASE 3: HEADERS E STATUS CUSTOMIZADOS
# ==========================================

# Simular um Erro 401 usando a API real do GitHub (Sem enviar o token)
res_auth = solicitar("https://api.github.com/user").avancado({
    "method": "GET"
})
# A API do GitHub exige autenticação. Como não enviamos, ela devolverá o correto 401 Unauthorized!
afirmar(res_auth.status == 401)
afirmar(res_auth.ok == falso)

# Lendo headers case-insensitive recebidos nativamente
res_head = solicitar("https://jsonplaceholder.typicode.com/users/1").avancado({ "method": "GET" })
afirmar(res_head.headers["content-type"] == "application/json; charset=utf-8")


# ==========================================
# FASE 4: BINÁRIOS, FILE I/O E UFCS
# ==========================================
criar_diretorio("pasta_temporaria_ultron")

# 1. Baixar uma imagem PNG da internet (Binário Puro, contém bytes nulos \0)
# Vamos baixar o mascote do GitHub usando a própria rede de distribuição deles (CDN Global Intravável)
res_bin = solicitar("https://avatars.githubusercontent.com/u/9919?v=4").avancado({ "method": "GET" })
afirmar(res_bin.status == 200)
tamanho_binario = tamanho(res_bin.bytes)
afirmar(tamanho_binario > 1000)

# 2. Gravar o U_BYTES puro no disco (Zero-Copy fwrite)
escrever_arquivo("teste_imagem.png", res_bin.bytes)
escrever_arquivo("pasta_temporaria_ultron/teste_imagem_backup.png", res_bin.bytes)

# 3. Ler o arquivo binário do disco de volta para a RAM
img_disco = ler_arquivo("teste_imagem.png")
afirmar(img_disco.ok == verdadeiro)
afirmar(tamanho(img_disco.bytes) == tamanho_binario) # Integridade Total de Bytes preservada!

# 4. Gravar Dicionários diretamente no disco (Ultron serializa sozinho!)
config = { "motor": "Tachyon", "versao": 1, "seguro": verdadeiro }
escrever_arquivo("config_ultron.json", config)

# 5. Ler Texto do disco e converter usando UFCS .json()
arq_config = ler_arquivo("config_ultron.json")
afirmar(arq_config.ok == verdadeiro)

config_lida = arq_config.texto.json()
afirmar(config_lida["motor"] == "Tachyon")
afirmar(config_lida["seguro"] == verdadeiro)

# 6. UFCS Matemático
afirmar("42".int() + 10 == 52)


# 7. Apagar ambiente (Limpeza Atômica Multi-OS)
remover_diretorio("pasta_temporaria_ultron", verdadeiro)
remover_arquivo("teste_imagem.png")
remover_arquivo("config_ultron.json")