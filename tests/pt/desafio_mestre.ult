# =====================================================================
# 🔥 O DESAFIO MESTRE: MATRIZES, F-STRINGS, DUCK-TYPING E I/O FIRE-AND-FORGET
# =====================================================================

imprimir("=== 1. Construindo o Objeto Dinâmico em RAM! ===")

# O AST vai identificar as chaves {} e [] e acionar a PNUMA Native C (UDict/UArray)
dados_usuario = { "nome": "João", "cargo": "Desenvolvedor Full-Stack", "ativo": verdadeiro, "linguagens": ["Python", "JavaScript", "Rust"], "projetos": { "total": 5, "principal": "Krystalis" } }

# 2. Serializando o Hash Map para String C (O(1) recursion)
json_string = json.dumps(dados_usuario)
imprimir(f"JSON Gerado na base: {json_string}")

imprimir("\n=== 3. Manipulação Orientada a Objetos ===")
# Alterando chaves soltas (Overloading Polimórfico C11 u_set)
dados_usuario["localizacao"] = "Parauapebas, PA"

# Chamando Métodos Mágicos Internos em Arrays
dados_usuario["linguagens"].append("TypeScript")

# 4. Criando e Acoplando Matrizes Multidimensionais Mistas
grid_multidimensional = [ [10, 20, 30], [40, 50, 60], [70, 80, 90] ]

status_projetos_matriz = [
    ["Krystalis", "Em desenvolvimento", "Concluido"],
    ["ZenithFrame", "Planejamento", "Em desenvolvimento"],
    ["NeuralDub", "Concluido", "Manutencao"]
]

dados_usuario["grid_coordenadas"] = grid_multidimensional
dados_usuario["historico_projetos"] = status_projetos_matriz

imprimir("\n=== 5. Devorando Operadores Python para <math.h> do C ===")
total_projetos = dados_usuario["projetos"]["total"]
num_linguagens = len(dados_usuario["linguagens"])

valor_centro_grid = grid_multidimensional[1][1]
valor_canto_grid = grid_multidimensional[0][0]

metricas_matematicas = {
    "soma": total_projetos + num_linguagens,                
    "subtracao": total_projetos - 2,                        
    "multiplicacao": num_linguagens * 2,                    
    "divisao_real": total_projetos / 2,                     
    "divisao_inteira": total_projetos // 2,                 
    "potencia": total_projetos ** 2,                        
    "raiz_quadrada": math.sqrt(total_projetos),             
    "arredondamento_cima": math.ceil(5.2),                  
    "arredondamento_baixo": math.floor(5.8),                
    "calculo_matriz": (valor_centro_grid + valor_canto_grid) // 3
}

dados_usuario["metricas_matematicas"] = metricas_matematicas

imprimir("\n=== 6. I/O Absoluto Sem Handles Bloqueantes ===")
nome_arquivo = "usuario.json"
novo_json = json.dumps(dados_usuario)

# Salvamos na velocidade da luz (Fire and Forget I/O), sem "with open()"
escrever_arquivo(nome_arquivo, novo_json)
imprimir(f"[Sucesso] Arquivo '{nome_arquivo}' escrito com arrays e math.h native!")

imprimir("\n=== 7. O Teste Final: Leitura e Reconstrução Estática (Deserialização) ===")
# O C lê a String, corta tudo, constrói ponteiros UDict e UArray no ar!
dados_lidos = json.loads(ler_arquivo(nome_arquivo))

centro = dados_lidos["grid_coordenadas"][1][1]
imprimir(f"Lido via Indexação Overload! Canto Central do Grid: {centro}")

tam_historico = len(dados_lidos["historico_projetos"])
imprimir(f"O Array Historico leu {tam_historico} nós da raiz recursiva com Sucesso.")

# Json Completo LIDO com Sucesso!
resultado_final = json.dumps(dados_lidos["metricas_matematicas"])
imprimir(f"Metricas Salvas e Lidas da C-RAM: {resultado_final}")

imprimir("\n✅ O DESAFIO FOI ANIQUILADO COM SUCESSO AOT!")