# ====================================================================
# ⚡ GUIA VIVO: ORIENTAÇÃO A OBJETOS, TRAITS E GERENCIAMENTO DE MEMÓRIA
# Arquivo: pt/classes.ult
# ====================================================================

# ====================================================================
# 1. FUNÇÕES AUXILIARES, TIPAGEM E SOBRECARGA COM VALORES-PADRÃO
# ====================================================================

fn fibonacci(int n):
    se n <= 1:
        retornar n
    retornar fibonacci(n - 1) + fibonacci(n - 2)

afirmar(fibonacci(7) == 13.0)

fn calcular_dano(double ataque_base, string tipo_dano, multiplicador = 1.5, double reducao = 0.0):
    deixe dano_final = (ataque_base * multiplicador) - reducao
    retornar f"[{tipo_dano}] Dano: {dano_final}"

afirmar(calcular_dano(100.0, "Água", 2.0, 10.0) == "[Água] Dano: 190")
afirmar(calcular_dano(100.0, "Fogo", 2.0) == "[Fogo] Dano: 200")
afirmar(calcular_dano(100.0, "Terra") == "[Terra] Dano: 150")

# ====================================================================
# 2. TRAITS E INTERFACES CONTRATUAIS
# ====================================================================

trait Interagivel:
    fn interagir(forca):

trait Renderizavel:
    fn desenhar():

# ====================================================================
# 3. HIERARQUIA DE CLASSES, MEMORY PUNNING E COMPOSIÇÃO
# ====================================================================

classe EntidadeBase:
    id = 0.0
    estado = "Ativo"
    durabilidade = 100.0

    fn reparar(double valor):
        meu.durabilidade = meu.durabilidade + valor

classe Barril usa EntidadeBase, Interagivel, Renderizavel:
    id = 0.0
    estado = "Ativo"
    durabilidade = 100.0

    itens = []
    camadas_protecao = 2.0

    fn init(double serial, double durabilidade_inicial):
        meu.id = serial
        meu.durabilidade = durabilidade_inicial
        meu.itens.append("Madeira")

    fn desenhar():
        retornar f"Barril #{meu.id} [{meu.estado}]"

    fn interagir(forca = 10.0):
        meu.durabilidade = meu.durabilidade - forca
        se meu.durabilidade <= 0.0:
            meu.estado = "Destruido"
        senao:
            meu.estado = "Danificado"

b1 = novo Barril(101.0, 50.0)
b2 = novo Barril(102.0, 20.0)

b1.itens.append("Ouro")
b1.itens.append("Gema")
b2.itens.append("Ferro")

afirmar(tamanho(b1.itens) == 3.0)
afirmar(tamanho(b2.itens) == 2.0)

afirmar(b1.desenhar() == "Barril #101 [Ativo]")

b1.interagir(15.0)
afirmar(b1.durabilidade == 35.0)
afirmar(b1.estado == "Danificado")

b1.interagir(40.0)
afirmar(b1.durabilidade == -5.0)
afirmar(b1.estado == "Destruido")

# ====================================================================
# 4. DISPATCH ESTÁTICO DE ALTA VELOCIDADE (STATIC DISPATCH)
# ====================================================================

fn reforcar_estrutura(EntidadeBase entidade, double bonus):
    entidade.reparar(bonus)

reforcar_estrutura(b2, 30.0)
afirmar(b2.durabilidade == 50.0)

# ====================================================================
# 5. GERENCIAMENTO DE MEMÓRIA: DESTRUIÇÃO EXPLÍCITA COM matar()
# ====================================================================

alvo_descarte = novo Barril(999.0, 10.0)
afirmar(alvo_descarte.id == 999.0)

# Invalida o slot na Arena DOD
matar(alvo_descarte)

# ====================================================================
# 6. RAII E ESCOPO AUTOMÁTICO (LIVENESS ANALYSIS)
# ====================================================================

registro_coleta = 0.0

se verdadeiro:
    deixe objeto_efemero = novo Barril(500.0, 1.0)
    objeto_efemero.itens.append("Artefato Raro")
    afirmar(tamanho(objeto_efemero.itens) == 2.0)
    registro_coleta = objeto_efemero.id

afirmar(registro_coleta == 500.0)

# ====================================================================
# 7. TRATAMENTO DE EXCEÇÕES E JUMPS NATIVOS
# ====================================================================

sistema_estavel = verdadeiro
mensagem_excecao = ""

tentar:
    jogar "FalhaCriticaControle"
    sistema_estavel = falso
capturar stack_err:
    mensagem_excecao = stack_err

afirmar(sistema_estavel == verdadeiro)
afirmar(mensagem_excecao == "FalhaCriticaControle")